# ===== 默认:Google Gemini 免费层(推荐)=====
# 申请免费 key(邮箱登录,不要信用卡):https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxx

# 可选:覆盖默认模型。默认已用 gemini-flash-latest(自动指向最新免费 Flash)
# 免费层可选:gemini-flash-latest / gemini-3-flash / gemini-2.5-flash-lite
# JP_AGENT_MODEL=gemini-flash-latest


# ===== 想换供应商?只改这两行即可(都是 OpenAI 兼容)=====
# --- Groq(免费、快)---
# LLM_API_KEY=gsk_xxxx
# LLM_BASE_URL=https://api.groq.com/openai/v1
# JP_AGENT_MODEL=llama-3.3-70b-versatile

# --- DeepSeek(极便宜,中文强)---
# LLM_API_KEY=sk-xxxx
# LLM_BASE_URL=https://api.deepseek.com
# JP_AGENT_MODEL=deepseek-chat

# --- OpenRouter(模型多)---
# LLM_API_KEY=sk-or-xxxx
# LLM_BASE_URL=https://openrouter.ai/api/v1
